{
  "title": "F3Next Context Engine & CVS",
  "uid": "f3next-context-cvs",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "CVS webhooks (rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(cvs_webhook_requests_total[5m])) by (result)",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Context engine load (p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(context_engine_load_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Context engine requests",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(increase(context_engine_requests_total[1h])) by (result)",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 8 }
    },
    {
      "type": "stat",
      "title": "CVS force-sync (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(increase(cvs_force_sync_requests_total[1h])) by (result)",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 8 }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  }
}
