# Copy to frontend/.env.local (or merge into root .env for Docker frontend_web).
# Dev-only: skips Supabase Auth while cloud auth is restricted.
NEXT_PUBLIC_DEV_AUTH_BYPASS=true
NEXT_PUBLIC_DEV_AUTH_USER_ID=dev-user-local-001
NEXT_PUBLIC_DEV_AUTH_EMAIL=dev@f3next.local

# Supabase vars can stay commented out while bypass is enabled.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
