    "entity_types": {
      "customer": {
        "erp_field": "customer",
        "field_type": "Link",
        "link_doctype": "Customer",
        "validation": "must_exist",
        "synonyms": ["client", "buyer", "party"],
        "extraction_patterns": [
          "for customer {name}",
          "customer {name}",
          "{name} (if context is sales-related)"
        ]
      },
      "supplier": {
        "erp_field": "supplier",
        "field_type": "Link",
        "link_doctype": "Supplier",
        "validation": "must_exist",
        "synonyms": ["vendor", "seller"],
        "extraction_patterns": [
          "from supplier {name}",
          "supplier {name}",
          "to {name} (if context is purchase-related)"
        ]
      },
      "item": {
        "erp_field": "item_code",
        "field_type": "Link",
        "link_doctype": "Item",
        "validation": "must_exist",
        "synonyms": ["product", "goods", "material", "sku", "part"],
        "extraction_patterns": [
          "{qty} units of {item_name}",
          "{qty} {item_name}",
          "{item_name} @ {rate}"
        ]
      },
      "qty": {
        "erp_field": "qty",
        "field_type": "Float",
        "validation": "must_be_positive",
        "synonyms": ["quantity", "units", "pieces", "count", "nos"],
        "extraction_patterns": [
          "{number} units",
          "{number} pieces",
          "{number} kg",
          "{number} {uom}"
        ]
      },
      "rate": {
        "erp_field": "rate",
        "field_type": "Currency",
        "validation": "must_be_positive",
        "synonyms": ["price", "unit price", "per unit", "each"],
        "extraction_patterns": [
          "@ ₹{amount}",
          "at ₹{amount}",
          "₹{amount} per unit",
          "rate {amount}"
        ]
      },
      "warehouse": {
        "erp_field": "warehouse",
        "field_type": "Link",
        "link_doctype": "Warehouse",
        "validation": "must_exist",
        "synonyms": ["store", "godown", "location"],
        "extraction_patterns": [
          "from {warehouse_name}",
          "to {warehouse_name}",
          "in {warehouse_name}"
        ]
      },
      "delivery_date": {
        "erp_field": "delivery_date",
        "field_type": "Date",
        "validation": "must_be_valid_date",
        "synonyms": ["deliver by", "delivery deadline", "shipment date", "due date"],
        "extraction_patterns": [
          "by {date}",
          "deliver by {date}",
          "on {date}",
          "{date} (if context indicates future date)"
        ]
      },
      "amount": {
        "erp_field": "paid_amount",
        "field_type": "Currency",
        "validation": "must_be_positive",
        "synonyms": ["total", "value", "sum"],
        "extraction_patterns": [
          "₹{amount}",
          "{amount} rupees",
          "{amount} lakh",
          "{amount}K"
        ]
      },
      "project": {
        "erp_field": "project",
        "field_type": "Link",
        "link_doctype": "Project",
        "validation": "must_exist",
        "synonyms": ["job", "work order"],
        "extraction_patterns": [
          "for project {name}",
          "to project {name}",
          "job {name}"
        ]
      }
    },
  
    "synonym_mappings": {
      "SO": "Sales Order",
      "PO": "Purchase Order",
      "DN": "Delivery Note",
      "PR": "Purchase Receipt",
      "SI": "Sales Invoice",
      "PI": "Purchase Invoice",
      "PE": "Payment Entry",
      "SE": "Stock Entry",
      "JE": "Journal Entry",
      "QTN": "Quotation",
      "SQ": "Supplier Quotation",
      "MR": "Material Request",
      "WO": "Work Order",
      "JC": "Job Card",
      "GRN": "Purchase Receipt",
      "BOM": "BOM",
      "QI": "Quality Inspection"
    },
  
    "ambiguity_resolution": {
      "missing_customer": {
        "question": "Which customer is this for?",
        "options_source": "recent_customers_or_search",
        "max_options": 5
      },
      "missing_supplier": {
        "question": "Which supplier?",
        "options_source": "recent_suppliers_or_search",
        "max_options": 5
      },
      "missing_item": {
        "question": "Which item/product?",
        "options_source": "recent_items_or_search",
        "max_options": 5
      },
      "missing_quantity": {
        "question": "How many units?",
        "options_source": "user_input_number",
        "validation": "positive_number"
      },
      "missing_rate": {
        "question": "What's the rate per unit?",
        "options_source": "price_list_or_user_input",
        "fallback": "fetch_from_price_list"
      },
      "multiple_customer_matches": {
        "question": "Did you mean:",
        "options_source": "matched_customers",
        "display_format": "{customer_name} ({customer_group}, {territory})"
      },
      "multiple_item_matches": {
        "question": "Did you mean:",
        "options_source": "matched_items",
        "display_format": "{item_name} ({item_code}, {item_group})"
      },
      "unclear_date": {
        "question": "When should this be delivered?",
        "options_source": ["today", "tomorrow", "next_week", "user_input"],
        "format": "dd-mm-yyyy"
      },
      "unclear_doctype": {
        "question": "What type of document?",
        "options_source": ["Sales Order", "Sales Invoice", "Purchase Order", "Delivery Note"],
        "context_based": true
      }
    },
  
    "contextual_inference_rules": {
      "payment_entry": {
        "from_customer_implies": {
          "payment_type": "Receive",
