{
    "knowledge_base_id": "intent_definitions",
    "version": "1.0",
    "erp_system": "erpnext",
    "last_updated": "2025-02-17",
    "description": "Comprehensive intent taxonomy mapping natural language commands to ERPNext doctypes and actions. Used by Clarity Agent for intent classification and entity extraction.",
    
    "intent_categories": {
      "create": "Create new documents/records",
      "read": "View/retrieve existing documents",
      "update": "Modify existing documents",
      "delete": "Remove draft documents",
      "search": "Find documents based on criteria",
      "submit": "Submit draft documents (workflow transition)",
      "cancel": "Cancel submitted documents",
      "report": "Generate reports and analytics",
      "bulk": "Batch operations on multiple records"
    },
  
    "intents": [
      {
        "intent_id": "create_sales_order",
        "category": "create",
        "target_doctype": "Sales Order",
        "action": "create",
        "confidence_threshold": 0.85,
        "synonyms": [
          "make sales order",
          "create SO",
          "new sales order",
          "place order",
          "create order for customer",
          "book order",
          "sales order for",
          "SO for customer"
        ],
        "required_entities": ["customer", "items"],
        "optional_entities": [
          "delivery_date",
          "po_no",
          "po_date",
          "taxes_and_charges",
          "payment_terms_template",
          "currency",
          "price_list",
          "project"
        ],
        "examples": [
          "Create SO for ABC Industries for 100 Product-001 at ₹500",
          "Make sales order for customer XYZ: 50 units Item-A, 20 units Item-B",
          "Place order for Sharma Trading - 200 pieces of Widget-123 deliver by March 15",
          "Book order against PO #12345 from Kumar & Co for 1000 units",
          "Create sales order for ABC Ltd: Product-A 100 qty @ 500, Product-B 50 qty @ 300"
        ],
        "negative_examples": [
          "Show me sales order SO-001",
          "Cancel sales order",
          "How many sales orders do we have?"
        ],
        "context_hints": {
          "customer_extraction": "If 'for customer X' or 'for X' mentioned, extract as customer",
          "items_extraction": "Pattern: [quantity] [unit] [item_name] [at/@ rate]",
          "delivery_date": "Phrases: 'by [date]', 'deliver by', 'delivery on', 'ship by'",
          "po_reference": "Phrases: 'against PO', 'PO number', 'PO #', 'customer PO'"
        },
        "validation_rules": {
          "customer_must_exist": true,
          "items_must_exist": true,
          "qty_must_be_positive": true,
          "rate_validation": "optional_but_if_present_must_be_positive"
        },
        "risk_level": "low"
      },
  
