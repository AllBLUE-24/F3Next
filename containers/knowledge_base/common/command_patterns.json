{
    "knowledge_base_id": "command_patterns",
    "version": "1.0",
    "erp_system": "erpnext",
    "last_updated": "2025-02-17",
    "description": "Pre-defined execution patterns for common multi-step workflows. Used by Command Planning Agent to decompose complex intents into atomic steps.",
    
    "patterns": [
      {
        "pattern_id": "sales_cycle_so_dn_si",
        "pattern_name": "Full Sales Cycle (Order → Delivery → Invoice)",
        "trigger_keywords": [
          "create order and invoice",
          "full sales cycle",
          "order deliver and invoice",
          "SO DN SI",
          "complete sales process"
        ],
        "description": "Create Sales Order, Delivery Note, and Sales Invoice in sequence",
        "steps": [
          {
            "step_number": 1,
            "action": "create",
            "doctype": "Sales Order",
            "required_fields": ["customer", "items"],
            "optional_fields": ["delivery_date", "po_no"],
            "depends_on": null,
            "rollback_if_failed": true
          },
          {
            "step_number": 2,
            "action": "submit",
            "doctype": "Sales Order",
            "target": "result_from_step_1",
            "depends_on": "step_1",
            "rollback_if_failed": true
          },
          {
            "step_number": 3,
            "action": "create_from",
            "doctype": "Delivery Note",
            "source_doctype": "Sales Order",
            "source": "result_from_step_2",
            "fetch_fields": ["customer", "items", "taxes_and_charges"],
            "depends_on": "step_2",
            "rollback_if_failed": true
          },
          {
            "step_number": 4,
            "action": "submit",
            "doctype": "Delivery Note",
            "target": "result_from_step_3",
            "depends_on": "step_3",
            "rollback_if_failed": false,
            "rollback_note": "If DN submission fails, SO and DN draft remain. Manual cleanup needed."
          },
          {
            "step_number": 5,
            "action": "create_from",
            "doctype": "Sales Invoice",
            "source_doctype": "Delivery Note",
            "source": "result_from_step_4",
            "fetch_fields": ["customer", "items", "taxes_and_charges"],
            "depends_on": "step_4",
            "rollback_if_failed": false
          },
          {
            "step_number": 6,
            "action": "submit",
            "doctype": "Sales Invoice",
            "target": "result_from_step_5",
            "depends_on": "step_5",
            "rollback_if_failed": false
          }
        ],
        "estimated_duration_seconds": 15,
        "risk_level": "high",
        "confirmation_required": true,
        "confirmation_message": "This will create Sales Order, Delivery Note, and Sales Invoice. Proceed?",
        "success_message": "✅ Full sales cycle completed!\n- Sales Order: {step_2_result}\n- Delivery Note: {step_4_result}\n- Sales Invoice: {step_6_result}",
        "partial_failure_handling": "If any step fails mid-way, earlier steps cannot be auto-rolled back (submitted docs can't be deleted). User will be informed of which step failed."
      },
  
      {
        "pattern_id": "sales_cycle_so_si",
        "pattern_name": "Sales Order → Invoice (No Delivery Note)",
        "trigger_keywords": [
          "order and invoice",
          "SO and invoice",
          "skip delivery note"
        ],
        "description": "Create Sales Order and Invoice directly (for services or advance invoicing)",
        "steps": [
          {
            "step_number": 1,
            "action": "create",
            "doctype": "Sales Order",
            "required_fields": ["customer", "items"],
            "depends_on": null
          },
          {
            "step_number": 2,
            "action": "submit",
            "doctype": "Sales Order",
            "target": "result_from_step_1",
            "depends_on": "step_1"
          },
          {
            "step_number": 3,
            "action": "create_from",
            "doctype": "Sales Invoice",
            "source_doctype": "Sales Order",
            "source": "result_from_step_2",
            "fetch_fields": ["customer", "items", "taxes_and_charges"],
            "depends_on": "step_2"
          },
          {
            "step_number": 4,
            "action": "submit",
            "doctype": "Sales Invoice",
            "target": "result_from_step_3",
            "depends_on": "step_3"
          }
        ],
        "estimated_duration_seconds": 10,
        "risk_level": "medium",
        "confirmation_required": false
      },
  
      {
