    },
  
    "cross_module_workflows": {
      "sales_to_accounts": {
        "description": "How sales transactions flow to accounting",
        "flow": "Sales Invoice (submitted) → GL Entry (auto-created) → Affects Debtors, Income, Tax accounts"
      },
      "purchase_to_accounts": {
        "description": "How purchase transactions flow to accounting",
        "flow": "Purchase Invoice (submitted) → GL Entry (auto-created) → Affects Creditors, Expense, Tax accounts"
      },
      "stock_to_accounts": {
        "description": "How stock movements affect accounting",
        "flow": "Stock Entry/Purchase Receipt/Delivery Note → Stock Ledger Entry + GL Entry → Affects Stock account valuation"
      },
      "manufacturing_to_stock": {
        "description": "How production affects stock",
        "flow": "Work Order Completion → Stock Entry (Manufacture) → Consume raw materials, Produce finished goods"
      },
      "project_costing": {
        "description": "How costs accumulate to projects",
        "flow": "Stock Entry/Timesheet/Expense Claim linked to Project → Project Cost aggregated → Project Profitability Report"
      }
    },
  
    "india_compliance": {
      "gst": {
        "description": "GST (Goods and Services Tax) compliance built into ERPNext",
        "features": [
          "CGST, SGST, IGST calculation based on customer/supplier state",
          "GST Sales Register report",
          "GST Purchase Register report",
          "GSTR-1, GSTR-3B data export",
          "HSN/SAC code tracking",
          "Tax Invoice format with GST details"
        ],
        "doctypes": ["GST Settings", "GST HSN Code", "GST Account"]
      },
      "e_invoicing": {
        "description": "e-Invoicing (IRN generation) for turnover >₹5 crore",
        "features": [
          "IRN generation via NIC/GSP API",
          "QR code on invoice",
          "e-Invoice cancellation",
          "Automatic e-Way Bill generation from e-Invoice"
        ]
      },
      "e_way_bill": {
        "description": "e-Way Bill for goods movement",
        "features": [
          "e-Way Bill generation from Delivery Note/Sales Invoice",
          "Vehicle number, transporter details",
          "Valid for inter-state >₹50,000"
        ]
      },
      "tds": {
        "description": "TDS (Tax Deducted at Source)",
        "features": [
          "TDS calculation on payments",
          "TDS category master",
          "Form 16A generation",
          "26AS reconciliation"
        ]
      }
    }
