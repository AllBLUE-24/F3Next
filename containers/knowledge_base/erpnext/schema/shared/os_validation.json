{
  "description": "OS validation semantics — maps ERPNext Link targets to CVS entity_registry keys",
  "link_target_to_cvs_registry": {
    "Customer": "known_customers",
    "Supplier": "known_suppliers",
    "Item": "known_items",
    "Warehouse": "known_warehouses"
  },
  "erp_autofill_fields": [
    "naming_series",
    "company",
    "currency",
    "conversion_rate",
    "selling_price_list",
    "buying_price_list",
    "price_list_currency",
    "plc_conversion_rate",
    "order_type",
    "transaction_date",
    "posting_date",
    "status",
    "title"
  ],
  "transaction_title_pattern": "{party_slug}-{item_slug}",
  "company_link_doctype": "Company",
  "company_fallback_policy": "first_live_when_pseudo_or_unmatched",
  "optional_business_fields": {
    "Sales Order": ["delivery_date"],
    "Delivery Note": ["delivery_date"],
    "Purchase Order": ["schedule_date"]
  },
  "sales_doctypes_require_customer": [
    "Sales Order",
    "Sales Invoice",
    "Delivery Note",
    "Quotation"
  ],
  "purchase_doctypes_require_supplier": [
    "Purchase Order",
    "Purchase Invoice",
    "Purchase Receipt"
  ],
  "delivery_date_skip_phrases": [
    "skip",
    "not needed",
    "not required",
    "no delivery",
    "no delivery date",
    "none",
    "n/a",
    "na",
    "nah",
    "naah",
    "no thanks",
    "omit"
  ],
  "master_create_doctypes": [
    "Item",
    "Customer",
    "Supplier",
    "Employee",
    "Warehouse",
    "Company"
  ],
  "company_resolution_policy": "user_default_company_or_first_live",
  "business_fields_by_doctype": {
    "Sales Order": ["customer", "items"],
    "Sales Invoice": ["customer", "items"],
    "Purchase Order": ["supplier", "items"],
    "Purchase Invoice": ["supplier", "items"],
    "Delivery Note": ["customer", "items"],
    "Quotation": ["customer", "items"],
    "Purchase Receipt": ["supplier", "items"]
  },
  "transaction_doctypes": [
    "Sales Order",
    "Sales Invoice",
    "Purchase Order",
    "Purchase Invoice",
    "Delivery Note",
    "Quotation",
    "Purchase Receipt",
    "Stock Entry",
    "Payment Entry",
    "Work Order"
  ]
}
