{
  "doctype_name": "Journal Entry",
  "naming_series": "JV-",
  "mandatory_fields": [
    "posting_date",
    "accounts"
  ],
  "field_mappings": {
    "posting_date": {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "mandatory": true,
      "default_value": "today",
      "user_input_synonyms": [
        "date",
        "entry_date",
        "voucher_date"
      ]
    },
    "voucher_type": {
      "fieldname": "voucher_type",
      "fieldtype": "Select",
      "options": [
        "Journal Entry",
        "Opening Entry",
        "Bank Entry",
        "Cash Entry",
        "Depreciation Entry"
      ],
      "mandatory": false,
      "default_value": "Journal Entry",
      "user_input_synonyms": [
        "entry_type",
        "type"
      ]
    },
    "accounts": {
      "fieldname": "accounts",
      "fieldtype": "Table",
      "child_doctype": "Journal Entry Account",
      "mandatory": true,
      "minimum_rows": 2,
      "child_fields": {
        "account": {
          "fieldname": "account",
          "fieldtype": "Link",
          "options": "Account",
          "mandatory": true,
          "user_input_synonyms": [
            "account_name",
            "ledger",
            "gl_account",
            "account name"
          ]
        },
        "debit_in_account_currency": {
          "fieldname": "debit_in_account_currency",
          "fieldtype": "Currency",
          "mandatory": false,
          "user_input_synonyms": [
            "debit",
            "dr",
            "debit_amount"
          ]
        },
        "credit_in_account_currency": {
          "fieldname": "credit_in_account_currency",
          "fieldtype": "Currency",
          "mandatory": false,
          "user_input_synonyms": [
            "credit",
            "cr",
            "credit_amount"
          ]
        },
        "account_type": {
          "fieldname": "account_type",
          "fieldtype": "Data",
          "mandatory": false,
          "user_input_synonyms": [
            "type",
            "account_type",
            "category"
          ]
        }
      }
    },
    "remark": {
      "fieldname": "remark",
      "fieldtype": "Small Text",
      "mandatory": false,
      "user_input_synonyms": [
        "narration",
        "description",
        "notes",
        "memo"
      ]
    },
    "balance": {
      "fieldname": "total_debit",
      "fieldtype": "Currency",
      "mandatory": false,
      "user_input_synonyms": [
        "balance",
        "amount",
        "balance (inr)",
        "balance_amount"
      ]
    }
  }
}